@startuml CreateBuchClean
title UML-Zustandsdiagramm – CreateBuch (NeuComponent)

state "index.html" as Index {

    [*] --> Home
    Home --> CreateBuch : Menüpunkt\n"Neues Buch"

    state CreateBuch {

        [*] --> FormularAnzeigen

        FormularAnzeigen --> Eingabe : Benutzer gibt Daten ein
    Eingabe --> Validierung : Button "Speichern"

        state Validierung {
            [*] --> Prüfen
            Prüfen --> Fehler : Formular ungültig\noder ISBN falsch
            Prüfen --> Auth : Formular gültig
        }

        Fehler --> Eingabe : Korrektur

        Auth --> Fehler : kein Token
        Auth --> Mutation : Token gültig

        Mutation --> FehlerServer : GraphQL-Fehler
        Mutation --> Erfolg : Mutation OK

        FehlerServer --> Eingabe

        Erfolg --> FormularAnzeigen : Formular reset()
    }

    CreateBuch --> Home : Logout
}

@enduml
